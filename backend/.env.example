# Copy to backend/.env. Never commit real credentials, URLs with signatures, or datasets.
DATABASE_PATH=backend/data/cqa.sqlite3
ORGANIZER_DATASET_URL=
ORGANIZER_TIMEOUT_SECONDS=20
MODEL_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini-2026-03-17
OPENAI_BASE_URL=https://api.openai.com/v1
PROVIDER_TIMEOUT_SECONDS=45
MAX_OUTPUT_TOKENS=8000
CORS_ORIGINS=http://localhost:5173

# Free local alternative (install Ollama and run: ollama pull qwen3:8b):
# MODEL_PROVIDER=ollama
# OPENAI_API_KEY=
# OPENAI_MODEL=qwen3:8b
# OPENAI_BASE_URL=http://127.0.0.1:11434
# PROVIDER_TIMEOUT_SECONDS=120
